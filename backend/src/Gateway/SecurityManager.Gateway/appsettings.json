{
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "ReverseProxy": {
    "Routes": {
      "auth-credentials": {
        "ClusterId": "identity",
        "RateLimiterPolicy": "auth",
        "Order": 1,
        "Match": { "Path": "/api/auth/{action:regex(^(login|refresh|change-password)$)}" }
      },
      "auth": {
        "ClusterId": "identity",
        "Order": 2,
        "Match": { "Path": "/api/auth/{**catch-all}" }
      },
      "firewall": {
        "ClusterId": "firewall",
        "Match": { "Path": "/api/firewall/{**catch-all}" }
      },
      "security": {
        "ClusterId": "security",
        "Match": { "Path": "/api/security/{**catch-all}" }
      },
      "network": {
        "ClusterId": "network",
        "Match": { "Path": "/api/network/{**catch-all}" }
      },
      "scanner": {
        "ClusterId": "scanner",
        "Match": { "Path": "/api/scanner/{**catch-all}" }
      },
      "alerts": {
        "ClusterId": "alert",
        "Match": { "Path": "/api/alerts/{**catch-all}" }
      },
      "alert-hub": {
        "ClusterId": "alert",
        "Match": { "Path": "/hubs/{**catch-all}" }
      }
    },
    "Clusters": {
      "identity": {
        "Destinations": { "primary": { "Address": "http://localhost:5105/" } }
      },
      "firewall": {
        "Destinations": { "primary": { "Address": "http://localhost:5101/" } }
      },
      "security": {
        "Destinations": { "primary": { "Address": "http://localhost:5102/" } }
      },
      "scanner": {
        "Destinations": { "primary": { "Address": "http://localhost:5103/" } }
      },
      "network": {
        "Destinations": { "primary": { "Address": "http://localhost:5106/" } }
      },
      "alert": {
        "Destinations": { "primary": { "Address": "http://localhost:5104/" } }
      }
    }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Yarp": "Warning"
    }
  },
  "AllowedHosts": "*"
}
