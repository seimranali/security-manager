{
  "Database": {
    "Provider": "Sqlite",
    "DataDirectory": "data"
  },
  "ConnectionStrings": {
    "ScannerDb": "Server=localhost;Database=SecurityManager_Scanner;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Services": {
    "Alert": "http://localhost:5104/"
  },
  "Scanner": {
    "MaxConcurrentProbes": 100,
    "ConnectTimeoutMs": 1000,
    "BannerTimeoutMs": 700,
    "HttpTimeoutSeconds": 10,
    "MaxParallelScans": 2,
    "SchedulerIntervalSeconds": 30
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "SecurityManager.Identity",
    "Audience": "SecurityManager",
    "SigningKey": "DEV-ONLY-change-me-0f6c2a9e4b7d41c8a35e92f1d6b08c7e5a4f3b2c1d0e9f8a",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AllowedHosts": "*"
}
