{
  "Database": {
    "Provider": "Sqlite",
    "DataDirectory": "data"
  },
  "ConnectionStrings": {
    "SecurityDb": "Server=localhost;Database=SecurityManager_Security;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Services": {
    "Alert": "http://localhost:5104/",
    "Firewall": "http://localhost:5101/"
  },
  "AutoBlock": {
    "Enabled": true,
    "MinSeverity": "High",
    "DurationMinutes": 1440,
    "ExcludePrivateRanges": true
  },
  "Cors": {
    "Origins": [ "http://localhost:5173" ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "Jwt": {
    "Issuer": "SecurityManager.Identity",
    "Audience": "SecurityManager",
    "SigningKey": "DEV-ONLY-change-me-0f6c2a9e4b7d41c8a35e92f1d6b08c7e5a4f3b2c1d0e9f8a",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7
  },
  "AllowedHosts": "*"
}
